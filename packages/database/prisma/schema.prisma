  listingId  String
  status     PlateVerificationStatus
  note       String?
  actorId    String?
  createdAt  DateTime                @default(now())

  @@index([listingId, createdAt])
  @@index([status])
}

// ─── Dealers ─────────────────────────────────────────────────────────────────

model DealerOrganization {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  /// Legacy denormalized flag; keep in sync with verificationStatus === VERIFIED
  verified           Boolean                   @default(false)
  verificationStatus DealerVerificationStatus  @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedById       String?
  rejectedAt         DateTime?
  rejectionReason    String?
  bio                String?
  phone              String?
  whatsapp           String?
  address            String?
  coverImageUrl      String?
  logoUrl            String?
  logoMediaId        String?                   @unique
  coverMediaId       String?                   @unique
  /// Free-form opening hours text or JSON string, e.g. "Sat–Thu 9:00–18:00"
  openingHours       String?
  cityId             String?
  followersCount     Int                       @default(0)
  viewsCount         Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  city               City?                        @relation(fields: [cityId], references: [id])
  verifiedBy         User?                        @relation("DealerVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  logoMedia          MediaAsset?                  @relation("DealerLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia         MediaAsset?                  @relation("DealerCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  members            DealerMember[]
  follows            DealerFollow[]
  conversations      Conversation[]
  verificationDocs   DealerVerificationDocument[]

  @@index([verified, deletedAt])
  @@index([verificationStatus, deletedAt])
  @@index([cityId])
}

model DealerMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           DealerMemberRole @default(STAFF)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization DealerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, deletedAt])
  @@index([organizationId, deletedAt])
}

/// KYC / business documents for dealer verification (extensible).
model DealerVerificationDocument {
  id             String                     @id @default(cuid())
  organizationId String
  mediaAssetId   String
  /// BUSINESS_LICENSE | OWNER_ID | OTHER
  purpose        String
  status         DealerDocumentReviewStatus @default(PENDING)
  note           String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  reviewedAt     DateTime?
  reviewedById   String?

  organization DealerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("DealerDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([mediaAssetId])
}

