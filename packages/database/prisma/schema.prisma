/// Plate domain catalog — plate usage class (Private, Taxi, …)
model PlateCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  plates PlateDetails[]

  @@index([active, sortOrder])
}

/// Plate domain catalog — letter/series prefix within a governorate format
model PlatePrefix {
  id           String   @id @default(cuid())
  formatCode   String
  letter       String
  label        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  plates PlateDetails[]

  @@unique([formatCode, letter])
  @@index([formatCode, active])
}

/// Plate verification audit events (domain-owned history)
model PlateVerification {
