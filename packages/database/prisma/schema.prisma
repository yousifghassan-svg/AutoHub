model PlateDetails {
  listingId          String                  @id
  formatCode         String
  plateDisplay       String
  plateNormalized    String
  series             String?
  number             String?
  regionCode         String?
  /// Visual plate class for SVG renderer (Private, Taxi, Government, Commercial, Diplomatic)
