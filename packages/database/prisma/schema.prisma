  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?

  governorate Governorate?   @relation(fields: [governorateId], references: [id])
  createdBy   User?          @relation("PlateFormatCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?          @relation("PlateFormatUpdatedBy", fields: [updatedById], references: [id])
