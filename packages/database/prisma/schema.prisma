  @@index([modelId])
}

model TruckDetails {
  listingId          String    @id
  brandId            String?
  modelId            String?
  year               Int
  mileageKm          Int?
  fuelTypeId         String?
  transmissionTypeId String?
  colorId            String?
  axleCount          Int?
  payloadKg          Int?
