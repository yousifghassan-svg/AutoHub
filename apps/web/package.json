{
  "name": "@autohub/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:url-state": "pnpm dlx tsx --test src/features/search/lib/url-search-state.spec.ts",
    "test:search-ux": "pnpm dlx tsx --test src/features/search/lib/vehicle-search-filters.spec.ts",
    "test:search-api-query": "pnpm dlx tsx --test src/features/vehicles/data/vehicle-search-api-query.spec.ts",
    "test:search": "pnpm dlx tsx --test src/features/search/lib/url-search-state.spec.ts src/features/search/lib/vehicle-search-filters.spec.ts src/features/vehicles/data/vehicle-search-api-query.spec.ts",
    "test:auth-return": "pnpm dlx tsx --test src/features/auth/domain/safe-next-path.spec.ts",
    "test:vehicle-sell": "pnpm dlx tsx --test src/features/vehicles/sell/submit.spec.ts",
    "test:listing-sell": "pnpm dlx tsx --test src/features/sell/lib/listing-price.spec.ts",
    "test:media-sell": "pnpm dlx tsx --test src/features/media/lib/ready-asset-ids.spec.ts src/features/media/lib/client-media-validation.spec.ts",
    "test:draft-engine": "pnpm dlx tsx --test src/features/sell/core/draft-store.spec.ts",
    "test:listing-quality": "pnpm dlx tsx --test src/features/sell/quality/adapt-wizard-state.spec.ts",
    "test:publish-flow": "pnpm dlx tsx --test src/features/sell/lib/publish-flow.spec.ts",
    "test:my-listings": "pnpm dlx tsx --test src/features/listings/lib/relative-time.spec.ts src/features/listings/shared/listing-actions.spec.ts"
  },
  "dependencies": {
    "@autohub/types": "workspace:*",
    "@autohub/ui": "workspace:*",
    "@autohub/utils": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
