NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth modes: firebase | dev
# - dev: OTP UX → POST /v1/auth/dev-login (API required; not allowed in production builds)
# - firebase: Firebase phone → POST /v1/auth/login (required for production builds)
# Legacy aliases (deprecated): mock→dev, api→firebase
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_DEV_OTP=123456

# Firebase Web SDK (required when NEXT_PUBLIC_AUTH_MODE=firebase)
# From Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Local only: skip interactive reCAPTCHA for Firebase Console test phone numbers.
# Never set true in production builds.
# NEXT_PUBLIC_FIREBASE_PHONE_TESTING=true

# Optional CDN base for R2 keys returned by the API
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=
