NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth modes: firebase | dev
# - dev: OTP UX → POST /v1/auth/dev-login (API required; not allowed in production builds)
# - firebase: Firebase phone → POST /v1/auth/login (required for production builds)
# Legacy aliases (deprecated): mock→dev, api→firebase
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_AUTH_DEV_OTP=123456

# Optional CDN base for R2 keys returned by the API
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=
