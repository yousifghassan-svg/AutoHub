EXPO_PUBLIC_API_URL=http://localhost:4000

# Public CDN / R2 base for listing image keys
EXPO_PUBLIC_MEDIA_BASE_URL=

# Auth modes: firebase | dev
# - dev: OTP UX → POST /v1/auth/dev-login (API required; forbidden in production builds)
# - firebase: Firebase phone → POST /v1/auth/login (required for production builds)
# Legacy aliases (deprecated): mock→dev, api→firebase
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_AUTH_DEV_OTP=123456

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
