DATABASE_URL=postgresql://autohub:autohub@localhost:5433/autohub?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# JWT (access tokens). Refresh tokens are opaque and stored hashed in DB.
# Production requires a strong secret (min 32 chars, not the framework default).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Non-Firebase login gates (development/staging only; always off in production)
AUTH_ALLOW_STAFF_LOGIN=true
AUTH_ALLOW_DEV_LOGIN=true
# Deprecated in 0.2 — dual-read only; remove in Release 0.3
# ALLOW_STAFF_DEV_LOGIN=true

# Firebase Admin (required for POST /v1/auth/login; required when NODE_ENV=production)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
